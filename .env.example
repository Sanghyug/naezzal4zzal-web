# Server only. Never use VITE_ for an API key.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4
ALLOWED_ORIGINS=https://naezzal4zzal-web.vercel.app,capacitor://localhost,https://localhost,http://localhost:5173,http://127.0.0.1:5173
# Required when packaging the iPhone app. Deploy the UPDATED server first.
VITE_API_BASE_URL=https://naezzal4zzal-web.vercel.app

# Server only. A paid HeyGen API key with videos:write and videos:read scopes.
HEYGEN_API_KEY=
# Private office beta access code; never expose as a VITE_ variable.
VIDEO_TEST_CODE=

# Launch features stay OFF until isolated external connections are verified.
VITE_LAUNCH_ENABLED=0
LAUNCH_ENABLED=0
LAUNCH_PREVIEW_SAFE=0
LAUNCH_ENV=test
# Required canonical https origin when enabling a hosted launch environment.
APP_BASE_URL=
# Separate Supabase TEST and PRODUCTION projects; direct/pooler PostgreSQL URL.
LAUNCH_DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate independent random 32+ byte values on the server; never VITE_.
LAUNCH_COOKIE_SECRET=
IDENTITY_HASH_SECRET=
LAUNCH_ADMIN_IDS=
# Test first. live requires production namespace AND explicit approval flag.
PAYMENT_MODE=toss-test
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
LIVE_COMMERCE_APPROVED=0
# Always mocked in test, regardless of existing paid provider keys.
ENABLE_LIVE_GENERATION=0
CRON_SECRET=
PUBLIC_SUPPORT_EMAIL=
BUSINESS_DETAILS_VERIFIED=0
