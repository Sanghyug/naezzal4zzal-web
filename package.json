{
  "name": "naezzal4zzal-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:launch": "vite --mode launch --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "build:launch": "npm run typecheck && vite build --mode launch",
    "vercel-build": "npm run typecheck && vite build",
    "web:build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "test:e2e": "playwright test",
    "test:launch-ui": "playwright test --config playwright.launch.config.mjs",
    "toss:build": "ait build",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^2.6.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@supabase/supabase-js": "2.119.2",
    "@tosspayments/tosspayments-sdk": "^2.10.0",
    "face-api.js": "^0.22.2",
    "ffmpeg-static": "^5.3.0",
    "gifshot": "^0.4.5",
    "gifuct-js": "^2.1.2",
    "pg": "^8.23.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0"
  }
}
